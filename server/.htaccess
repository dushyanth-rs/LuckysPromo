# Deployed to public_html/.htaccess on Hostinger.
# Every route in this site is a real pre-rendered HTML file/directory
# (Next.js static export with trailingSlash: true), so no SPA-style
# catch-all rewrite is used or needed - Apache's native file resolution
# is correct as-is.

RewriteEngine On

# Duplicate products merged into a single canonical listing (2026-10) -
# redirect their old URLs to the product they were folded into, in case
# any of them got indexed/linked before the merge.
RewriteRule ^products/srg-pn-1036/?$ https://luckyspromo.com/products/srg-pn-1017/ [R=301,L]
RewriteRule ^products/srg-pn-1036-b/?$ https://luckyspromo.com/products/srg-pn-1017/ [R=301,L]
RewriteRule ^products/srg-pn-1047-b/?$ https://luckyspromo.com/products/srg-pn-1047/ [R=301,L]
RewriteRule ^products/srg-kc-1005-b/?$ https://luckyspromo.com/products/srg-kc-1005/ [R=301,L]
RewriteRule ^products/srg-pn-1010/?$ https://luckyspromo.com/products/srg-pn-1016/ [R=301,L]
RewriteRule ^products/no-61/?$ https://luckyspromo.com/products/no-41/ [R=301,L]

# Canonicalize www -> apex domain (one hop, regardless of http/https)
RewriteCond %{HTTP_HOST} ^www\.luckyspromo\.com$ [NC]
RewriteRule ^(.*)$ https://luckyspromo.com/$1 [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Custom 404 page (Next's static export)
ErrorDocument 404 /404.html

DirectoryIndex index.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
